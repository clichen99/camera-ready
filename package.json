{
  "name": "camera-ready",
  "private": true,
  "version": "0.1.0",
  "description": "A satirical points-only sportsbook about academic publishing. CHI 2027 Interactive Demo.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:quiet": "node scripts/dev.mjs --no-bots",
    "bots": "node sim/fake-players.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "build": "vite build",
    "deploy:server": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.163.0"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  }
}
